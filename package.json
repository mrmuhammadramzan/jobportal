{
  "scripts": {
    "start": "cd rozedesk-app && node_modules/.bin/next start -p ${PORT:-3000}",
    "build": "cd rozedesk-app && npm install --ignore-engines && ./node_modules/.bin/prisma generate --schema=./prisma/schema.prisma && ./node_modules/.bin/next build"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0"
  }
}
