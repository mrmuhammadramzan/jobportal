// RozeDesk — Prisma Schema (MySQL / XAMPP)
// Switched from PostgreSQL to MySQL.
// MySQL differences:
//   - No native String[] arrays → use Json for lists
//   - @db.Text for long strings
//   - Enums work natively in MySQL

generator client {
  provider = "prisma-client-js"
  output   = "../rozedesk-app/src/generated/prisma"
}

datasource db {
  provider = "mysql"
  // NOTE: In Prisma 7, url is configured in prisma7.config.ts NOT here
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  SEEKER
  ADMIN
}

enum JobStatus {
  ACTIVE
  CLOSED
  DRAFT
}

enum ApplicationStatus {
  PENDING_PAYMENT
  PAYMENT_UNDER_REVIEW
  PAYMENT_REJECTED
  CV_UNDER_REVIEW
  SHORTLISTED
  REJECTED
  HIRED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  JAZZCASH
  EASYPAISA
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique // PK mobile e.g. 03001234567 — required for seekers, null for OAuth/admin
  passwordHash String
  role         Role     @default(SEEKER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resetToken       String?
  resetTokenExpiry DateTime?
  blocked          Boolean   @default(false)

  profile       SeekerProfile?
  applications  Application[]
  savedJobs     SavedJob[]
  alerts        Alert[]
  notifications Notification[]
  gameWallet    GameWallet?

  @@map("users")
}

// ─────────────────────────────────────────
// SEEKER PROFILE
// ─────────────────────────────────────────
model SeekerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone    String?
  location String?
  summary  String? @db.Text

  // MySQL: no native arrays — use Json
  skills Json @default("[]")

  linkedin  String?
  github    String?
  portfolio String?

  education      Json    @default("[]")
  experience     Json    @default("[]")
  currentProject String? @db.Text

  jobType       String?
  desiredSalary String?
  remotePref    String?
  cvUrl         String?
  updatedAt     DateTime @updatedAt

  @@map("seeker_profiles")
}

// ─────────────────────────────────────────
// JOB LISTING
// ─────────────────────────────────────────
model Job {
  id           String    @id @default(cuid())
  title        String
  company      String
  location     String
  type         String
  category     String
  description  String    @db.Text
  // MySQL: no native arrays — use Json
  requirements Json      @default("[]")
  benefits     Json      @default("[]")
  salaryMin    Int?
  salaryMax    Int?
  deadline     DateTime?
  status       JobStatus @default(ACTIVE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  applications Application[]
  savedBy      SavedJob[]

  @@map("jobs")
}

// ─────────────────────────────────────────
// APPLICATION
// ─────────────────────────────────────────
model Application {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cvUrl     String            @db.LongText
  status    ApplicationStatus @default(PENDING_PAYMENT)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  payment   Payment?

  @@unique([userId, jobId])
  @@map("applications")
}

// ─────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────
model Payment {
  id              String        @id @default(cuid())
  applicationId   String        @unique
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  amount          Int
  method          PaymentMethod
  receiptUrl      String        @db.LongText
  receiptRef      String?
  status          PaymentStatus @default(PENDING)
  rejectionReason String?       @db.Text
  submittedAt     DateTime      @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?

  @@map("payments")
}

// ─────────────────────────────────────────
// PAYMENT SETTINGS
// ─────────────────────────────────────────
model PaymentSetting {
  id        String   @id @default(cuid())
  method    String   @unique
  phone     String
  name      String
  address   String?
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("payment_settings")
}

// ─────────────────────────────────────────
// SAVED JOBS
// ─────────────────────────────────────────
model SavedJob {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId   String
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  savedAt DateTime @default(now())

  @@unique([userId, jobId])
  @@map("saved_jobs")
}

// ─────────────────────────────────────────
// JOB ALERTS
// ─────────────────────────────────────────
model Alert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywords  String
  location  String   @default("Any")
  type      String   @default("Any")
  frequency String   @default("Daily")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("alerts")
}

// ─────────────────────────────────────────
// ANALYTICS SUMMARY
// ─────────────────────────────────────────
model AnalyticsSummary {
  id           String   @id @default(cuid())
  date         DateTime @unique
  visitors     Int      @default(0)
  pageViews    Int      @default(0)
  applications Int      @default(0)
  newUsers     Int      @default(0)

  @@map("analytics_summaries")
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  type      String   @default("info") // info | success | warning | error | applicant | payment
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// ─────────────────────────────────────────
// PLATFORM SETTINGS
// ─────────────────────────────────────────
model PlatformSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ─────────────────────────────────────────
// GAME — ENUMS
// ─────────────────────────────────────────

enum GameDepositStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────
// GAME — WALLET
// One wallet per user, balance in PKR (Int = paisas * 100 avoided;
// we store integer rupees for simplicity, min 120)
// ─────────────────────────────────────────
model GameWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0) // PKR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deposits    GameDeposit[]
  sessions    GameSession[]
  withdrawals GameWithdrawal[]

  @@map("game_wallets")
}

// ─────────────────────────────────────────
// GAME — DEPOSIT REQUEST
// User uploads payment screenshot → admin approves → balance credited
// ─────────────────────────────────────────
model GameDeposit {
  id              String            @id @default(cuid())
  walletId        String
  wallet          GameWallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId          String
  amount          Int // PKR
  method          PaymentMethod
  screenshotUrl   String            @db.LongText // base64 or storage path
  status          GameDepositStatus @default(PENDING)
  rejectionReason String?           @db.Text
  submittedAt     DateTime          @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?

  @@index([userId])
  @@index([status])
  @@map("game_deposits")
}

// ─────────────────────────────────────────
// GAME — SESSION
// Records every game play: amount wagered, final score, winnings paid out
// ─────────────────────────────────────────
model GameSession {
  id          String     @id @default(cuid())
  walletId    String
  wallet      GameWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId      String
  wagerAmount Int // PKR deducted at session start
  finalScore  Int        @default(0)
  winAmount   Int        @default(0) // PKR credited at session end
  milestones  Json       @default("[]") // array of milestone scores awarded
  startedAt   DateTime   @default(now())
  endedAt     DateTime?
  completed   Boolean    @default(false)

  @@index([userId])
  @@map("game_sessions")
}

// ─────────────────────────────────────────
// GAME — WITHDRAWAL REQUEST
// User requests PKR withdrawal → admin approves → balance deducted
// ─────────────────────────────────────────

enum GameWithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model GameWithdrawal {
  id              String               @id @default(cuid())
  walletId        String
  wallet          GameWallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId          String
  amount          Int // PKR
  method          String // JAZZCASH | EASYPAISA
  accountNumber   String
  accountName     String
  status          GameWithdrawalStatus @default(PENDING)
  rejectionReason String?              @db.Text
  submittedAt     DateTime             @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?

  @@index([userId])
  @@index([status])
  @@map("game_withdrawals")
}
