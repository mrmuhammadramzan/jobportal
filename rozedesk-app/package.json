{
  "name": "rozedesk-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev":         "next dev",
    "build":       "prisma generate --schema=../prisma/schema.prisma && next build",
    "start":       "next start",
    "lint":        "eslint",
    "db:push":     "node ../node_modules/prisma/build/index.js db push --config ../prisma7.config.ts",
    "db:generate": "node ../node_modules/prisma/build/index.js generate --config ../prisma7.config.ts"
  },
  "dependencies": {
    "prisma":                  "^7.10.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client":          "^7.10.0",
    "@supabase/ssr":           "^0.12.7",
    "@supabase/supabase-js":   "^2.116.0",
    "@types/bcryptjs":         "^2.4.6",
    "@types/jsonwebtoken":     "^9.0.10",
    "@types/nodemailer":       "^8.0.1",
    "bcryptjs":                "^3.0.3",
    "jsonwebtoken":            "^9.0.3",
    "mariadb":                 "^3.5.4",
    "mysql2":                  "^3.24.4",
    "next":                    "16.3.5",
    "nodemailer":              "^10.0.10",
    "react":                   "19.2.8",
    "react-dom":               "19.2.8",
    "@tailwindcss/postcss":    "^4",
    "tailwindcss":             "^4",
    "typescript":              "^5"
  },
  "devDependencies": {
    "@types/node":           "^22",
    "@types/react":          "^19",
    "@types/react-dom":      "^19",
    "eslint":                "^9",
    "eslint-config-next":    "16.3.5"
  }
}
