{
    "name": "rozedesk-app",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "next dev",
        "clean": "node -e \"const fs=require('fs');fs.rmSync('.next',{recursive:true,force:true});console.log('.next cleared');\"",
        "dev:clean": "npm run clean && npm run dev",
        "build": "prisma generate --schema=../prisma/schema.prisma && next build",
        "start": "next start",
        "lint": "eslint",
        "db:push": "node ../node_modules/prisma/build/index.js db push --config ../prisma7.config.ts",
        "db:generate": "node ../node_modules/prisma/build/index.js generate --config ../prisma7.config.ts"
    },
    "dependencies": {
        "@pixi/particle-emitter": "5.0.8",
        "@prisma/adapter-mariadb": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "@supabase/ssr": "^0.12.7",
        "@supabase/supabase-js": "^2.116.0",
        "@tailwindcss/postcss": "^4",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/nodemailer": "^8.0.1",
        "bcryptjs": "^3.0.3",
        "gsap": "3.12.5",
        "jsonwebtoken": "^9.0.3",
        "mariadb": "^3.5.4",
        "mysql2": "^3.24.4",
        "next": "16.3.8",
        "nodemailer": "^10.0.10",
        "pixi.js": "8.6.1",
        "prisma": "^7.10.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "resend": "^4.0.0",
        "server-only": "0.0.1",
        "tailwindcss": "^4",
        "typescript": "^5"
    },
    "devDependencies": {
        "@types/node": "^22",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.3.5"
    }
}
